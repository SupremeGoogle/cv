# Шаблон переменных окружения. Реальные значения задаются в Vercel
# (Project → Settings → Environment Variables), а локально — в .env.local,
# который не коммитится. Здесь только пустые заглушки.
#
# ВАЖНО: секретам нельзя давать префикс VITE_ — Vite вшивает такие переменные
# в публичный JS-бандл. Всё, что ниже, читает только серверный код в api/*.

# Telegram-бот: через него приходят заявки и возвращается готовое фото.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Хранилище заявок (Vercel KV / Upstash Redis). При подключении интеграции
# Vercel подставляет эти переменные сам; достаточно одной из пар.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Понадобится, только если вернуть автоматическую генерацию через Gemini.
# Ключ: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-image
