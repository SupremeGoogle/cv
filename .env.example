# Шаблон переменных окружения. Реальные значения задаются в Vercel
# (Project → Settings → Environment Variables), а локально — в .env.local,
# который не коммитится. Здесь только пустые заглушки.
#
# ВАЖНО: секретам нельзя давать префикс VITE_ — Vite вшивает такие переменные
# в публичный JS-бандл. Всё, что ниже, читает только серверный код в api/*.

# DeepInfra: автоматическая генерация фото на рабочем месте (/api/generate).
# Ключ: https://deepinfra.com/dash/api_keys
DEEPINFRA_TOKEN=
# Модель по умолчанию — google/nano-banana-2 (лучшее сохранение лица).
# Альтернативы: ByteDance/Seedream-4.5 ($0.04/шт), black-forest-labs/FLUX-2-pro.
# DEEPINFRA_IMAGE_MODEL=google/nano-banana-2

# Защита бюджета: сколько автогенераций разрешено в сутки.
# По умолчанию 3 на IP и 25 на весь сайт. Всё сверх лимита уходит в ручной режим.
# AUTO_GEN_IP_DAILY_LIMIT=3
# AUTO_GEN_DAILY_LIMIT=25

# Telegram-бот: через него приходят заявки и возвращается готовое фото.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Длинная случайная строка (например `openssl rand -hex 32`). Делает две вещи:
#  - закрывает служебные /api/setup-webhook и /api/webhook-info (?secret=...)
#  - передаётся Telegram как secret_token, чтобы /api/telegram-webhook
#    принимал только настоящие апдейты, а не подделанные POST-запросы.
# После изменения обязательно открыть /api/setup-webhook?secret=... заново.
WEBHOOK_SECRET=

# Домен, на который регистрируется вебхук. Берётся НЕ из заголовков запроса —
# иначе чужой Host мог бы увести вебхук бота на сторонний сервер.
# PUBLIC_HOST=cv-akbar.vercel.app

# Хранилище заявок (Vercel KV / Upstash Redis). При подключении интеграции
# Vercel подставляет эти переменные сам; достаточно одной из пар.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Понадобится, только если вернуть автоматическую генерацию через Gemini.
# Ключ: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-image
